  function mediaState() {
    var v = null, a = null;
    if (localStream) {
      v = localStream.getVideoTracks()[0] || null;
      a = localStream.getAudioTracks()[0] || null;
    }
    return {
      video: !!(v && v.enabled && v.readyState === 'live'),
      audio: !!(a && a.enabled && a.readyState === 'live')
    };
  }

  function updateMediaUI() {
    var s = mediaState();

    if (prejoinPreview) prejoinPreview.srcObject = localStream;
    if (selfVideo) selfVideo.srcObject = localStream;

    prejoinPreview.style.visibility = s.video ? 'visible' : 'hidden';
    previewOff.classList.toggle('show', !s.video);

    selfVideo.style.visibility = s.video ? 'visible' : 'hidden';
    selfOffAvatar.style.display = s.video ? 'none' : 'grid';

    document.querySelectorAll('[data-mic]').forEach(function (b) {
      b.classList.toggle('off', !s.audio);
      b.setAttribute('aria-pressed', String(s.audio));
    });
    document.querySelectorAll('[data-cam]').forEach(function (b) {
      b.classList.toggle('off', !s.video);
      b.setAttribute('aria-pressed', String(s.video));
    });

    selfMicTag.classList.toggle('on', s.audio);
    selfMicTag.classList.toggle('off', !s.audio);
  }

  function ensureMedia() {
    if (localStream) return Promise.resolve();
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      return Promise.resolve();
    }
    return navigator.mediaDevices.getUserMedia({ video: true, audio: true })
      .then(function (stream) { localStream = stream; })
      .catch(function () {
        return navigator.mediaDevices.getUserMedia({ audio: true })
          .then(function (stream) { localStream = stream; })
          .catch(function () {});
      })
      .then(updateMediaUI);
  }

  function toggleMic() {
    if (!localStream) { ensureMedia(); return; }
    var t = localStream.getAudioTracks()[0];
    if (!t) { toast('No microphone found.'); return; }
    t.enabled = !t.enabled;
    updateMediaUI();
  }

  function toggleCam() {
    if (!localStream) { ensureMedia(); return; }
    var t = localStream.getVideoTracks()[0];
    if (t) { t.enabled = !t.enabled; updateMediaUI(); return; }

    navigator.mediaDevices.getUserMedia({ video: true })
      .then(function (s) {
        var vt = s.getVideoTracks()[0];
        if (vt) localStream.addTrack(vt);
        updateMediaUI();
      })
      .catch(function () { toast('Could not start the camera.'); });
  }

  function stopShare() {
    if (screenStream) {
      screenStream.getTracks().forEach(function (t) { t.stop(); });
      screenStream = null;
