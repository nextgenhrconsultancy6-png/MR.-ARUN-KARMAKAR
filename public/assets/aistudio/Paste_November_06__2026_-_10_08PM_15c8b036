<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
  'use strict';

  /* =========================================================
     Utilities
     ========================================================= */
  var pad = function (n) { return String(n).padStart(2, '0'); };
  var esc = function (s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };
  var uid = function () { return Math.random().toString(36).slice(2, 10); };
  var genPin = function () { return String(Math.floor(100000 + Math.random() * 900000)); };
  var slug = function (s) { return String(s).toLowerCase().replace(/\s+/g, '-'); };

  function fmtDateTime(ts) {
    return new Date(ts).toLocaleString(undefined, {
      weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
    });
  }
  function fmtTime(ts) {
    return new Date(ts).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
  }
  function initials(name) {
    return String(name || '').split(/\s+/).filter(Boolean).slice(0, 2)
      .map(function (w) { return w[0].toUpperCase(); }).join('');
  }
  function toLocalInput(d) {
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
           'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }

  var toastEl = document.getElementById('toast');
  var toastTimer = null;
  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2800);
  }
  function copyText(text, okMsg) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text)
        .then(function () { toast(okMsg); })
        .catch(function () { toast(text); });
    } else {
      toast(text);
    }
  }

  /* =========================================================
     Categories & category PINs
     ========================================================= */
  var CATS = ['Institutes', 'Companies', 'Candidates', 'All partners'];
  var DEFAULT_CAT_PINS = {
    'Institutes': '482913',
    'Companies': '715204',
    'Candidates': '390817',
    'All partners': '204815'
  };
  var PIN_KEY = 'nextgenn_catpins_v1';
  var ADMIN_PASS = 'admin1234';
  var JOIN_WINDOW_MS = 15 * 60 * 1000;

  function readCategoryPins() {
    var stored = {};
    try { stored = JSON.parse(localStorage.getItem(PIN_KEY) || '{}') || {}; }
    catch (e) { stored = {}; }
    var out = {};
    CATS.forEach(function (c) {
      out[c] = /^\d{6}$/.test(stored[c] || '') ? stored[c] : DEFAULT_CAT_PINS[c];
    });
    return out;
  }
  function saveCategoryPins(pins) {
    try { localStorage.setItem(PIN_KEY, JSON.stringify(pins)); } catch (e) {}
  }

  /* =========================================================
     Session store
     ========================================================= */
  var STORE_KEY = 'nextgenn_sessions_v1';

  function saveSessions(list) {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(list)); } catch (e) {}
  }

  function seedSessions() {
    var now = Date.now();
    var list = [
      {
        id: uid(),
        title: 'Campus to Corporate — Hiring Readiness',
        type: 'webinar',
        category: 'Institutes',
        host: 'Ava Moreau',
        start: now - 12 * 60000,
        durationMin: 60
      },
      {
        id: uid(),
        title: 'Skills-First Hiring Funnel',
        type: 'webinar',
        category: 'Companies',
        host: 'Jonas Keller',
        start: now + 2 * 86400000 + 3 * 3600000,
        durationMin: 45
      },
      {
        id: uid(),
        title: 'Interview Mastery Clinic',
        type: 'clinic',
        category: 'Candidates',
        host: 'Sana Rahman',
        start: now + 5 * 86400000 + 5 * 3600000,
        durationMin: 60
      },
      {
        id: uid(),
        title: 'Quarterly Talent Review',
        type: 'webinar',
        category: 'All partners',
        host: 'Ava Moreau',
        start: now + 9 * 86400000 + 2 * 3600000,
        durationMin: 30
      },
      {
        id: uid(),
        title: 'Employer Branding Masterclass',
        type: 'webinar',
        category: 'Companies',
        host: 'Jonas Keller',
        start: now + 12 * 86400000 + 4 * 3600000,
        durationMin: 50
      },
      /* Admin-created instant room — visible in Admin only, hidden from public schedule */
      {
        id: uid(),
        title: 'Instant Interview — Product Analyst',
        type: 'interview',
        instant: true,
        category: 'Interviews',
        host: 'Ava Moreau',
        candidate: 'Riya Sharma',
        role: 'Product Analyst',
        start: now - 5 * 60000,
        durationMin: 30,
        pin: '918273'
      }
    ];
    saveSessions(list);
    return list;
  }

  function readSessions() {
    var raw = null;
    try { raw = localStorage.getItem(STORE_KEY); } catch (e) { raw = null; }
    if (!raw) return seedSessions();
    try {
      var list = JSON.parse(raw);
      if (!Array.isArray(list) || !list.length) return seedSessions();
      return list;
    } catch (e) {
      return seedSessions();
    }
  }

  var SESSIONS = readSessions();

  function reloadSessions() {
    SESSIONS = readSessions();
    lastSig = '';
    refresh();
    renderAdminList();
    renderCatPins();
    paintCategoryPins();
  }

  /* Session state */
  function sessionState(s) {
    var now = Date.now();
    var start = s.start;
    var end = start + s.durationMin * 60000;
    var opens = start - JOIN_WINDOW_MS;
    if (now < opens) return { key: 'upcoming', label: 'Upcoming', joinable: false, opens: opens };
    if (now <= end) return { key: 'live', label: 'Live now', joinable: true };
    return { key: 'ended', label: 'Ended', joinable: false };
  }

  function sortedSessions() {
    return SESSIONS.slice().sort(function (a, b) { return a.start - b.start; });
  }

  /* =========================================================
     Public sessions UI + filtering
     Instant interview rooms are excluded from the public list.
     ========================================================= */
  var sessionListEl = document.getElementById('sessionList');
  var filterChips = document.getElementById('filterChips');
  var activeFilter = 'all';
  var lastSig = '';

  filterChips.addEventListener('click', function (e) {
    var chip = e.target.closest('.chip');
    if (!chip) return;
    activeFilter = chip.getAttribute('data-filter');
    Array.prototype.forEach.call(filterChips.querySelectorAll('.chip'), function (c) {
      c.classList.toggle('active', c === chip);
    });
    lastSig = '';
    refresh();
  });

  function visibleSessions() {
    var list = sortedSessions().filter(function (s) { return !s.instant; });
    if (activeFilter === 'all') return list;
    return list.filter(function (s) { return s.category === activeFilter; });
  }

  function renderSessions(list) {
    list = list || visibleSessions();
    if (!list.length) {
      sessionListEl.innerHTML =
        '<p class="empty-sessions">No scheduled sessions for this category yet. Your account manager will publish them here.</p>';
      return;
    }

    sessionListEl.innerHTML = list.map(function (s) {
      var st = sessionState(s);
      var isWebinar = s.type === 'webinar';

      var typeLabel = isWebinar ? 'Webinar' : 'Clinic';
      var typeClass = isWebinar ? 'webinar' : 'clinic';

      var cta;
      if (st.key === 'live') {
        cta = '<button class="btn btn-primary btn-sm" data-join="' + s.id + '">Join now</button>';
      } else if (st.key === 'upcoming') {
        cta = '<button class="btn btn-ghost btn-sm" data-join="' + s.id + '">Enter PIN</button>';
      } else {
        cta = '<button class="btn btn-ghost btn-sm" disabled>Ended</button>';
      }

      return '' +
        '<article class="session">' +
          '<div class="session-main">' +
            '<div class="session-top">' +
              '<span class="status ' + st.key + '">' + st.label + '</span>' +
              '<span class="type ' + typeClass + '">' + typeLabel + '</span>' +
              '<span class="aud ' + slug(s.category) + '">' + esc(s.category) + '</span>' +
            '</div>' +
            '<h3>' + esc(s.title) + '</h3>' +
            '<p class="session-meta">' + fmtDateTime(s.start) + ' · ' + s.durationMin +
              ' min · Host: ' + esc(s.host) + '</p>' +
          '</div>' +
          '<div class="session-side">' +
            '<span class="pin-badge">' + esc(s.category) + ' PIN</span>' +
            cta +
          '</div>' +
        '</article>';
    }).join('');
  }

  /* Featured card + countdown — scheduled sessions only */
  var nextTitleEl = document.getElementById('nextTitle');
  var nextWhenEl = document.getElementById('nextWhen');
  var nextAudEl = document.getElementById('nextAudience');
  var nextLabelEl = document.getElementById('nextLabel');
  var cdD = document.getElementById('cd-d');
  var cdH = document.getElementById('cd-h');
  var cdM = document.getElementById('cd-m');
  var cdS = document.getElementById('cd-s');

  function featuredSession() {
    var scheduled = SESSIONS.filter(function (s) { return !s.instant; });

    var live = scheduled.filter(function (s) { return sessionState(s).key === 'live'; })
      .sort(function (a, b) { return a.start - b.start; })[0];
    if (live) return { session: live, live: true };

    var upcoming = scheduled.filter(function (s) { return s.start > Date.now(); })
      .sort(function (a, b) { return a.start - b.start; })[0];
    if (upcoming) return { session: upcoming, live: false };
    return null;
  }

  function renderFeatured() {
    var f = featuredSession();
    if (!f) {
      nextLabelEl.textContent = 'Schedule';
      nextTitleEl.textContent = 'No sessions scheduled';
      nextWhenEl.textContent = 'Check back soon';
      nextAudEl.textContent = '—';
      return;
    }
    var s = f.session;
    nextLabelEl.textContent = f.live
      ? 'Happening now'
      : (s.type === 'webinar' ? 'Next scheduled webinar' : 'Next scheduled clinic');
    nextTitleEl.textContent = s.title;
    nextWhenEl.textContent = fmtDateTime(s.start) + ' · ' + s.durationMin + ' min';
    nextAudEl.textContent = s.category + ' · ' + s.category + ' PIN required';
  }

  function updateCountdown() {
    var f = featuredSession();
    var diff = 0;
    if (f) {
      var target = f.live ? (f.session.start + f.session.durationMin * 60000) : f.session.start;
      diff = Math.max(0, target - Date.now());
    }
    cdD.textContent = pad(Math.floor(diff / 86400000));
    cdH.textContent = pad(Math.floor((diff % 86400000) / 3600000));
    cdM.textContent = pad(Math.floor((diff % 3600000) / 60000));
    cdS.textContent = pad(Math.floor((diff % 60000) / 1000));
  }

  function refresh() {
    var list = visibleSessions();
    var sig = activeFilter + '::' + list.map(function (s) {
      return s.id + ':' + sessionState(s).key;
    }).join('|');

    if (sig !== lastSig) {
      lastSig = sig;
      renderSessions(list);
      renderFeatured();
    }
    updateCountdown();
  }

  setInterval(refresh, 1000);
  refresh();

  /* =========================================================
     Modal helpers
     ========================================================= */
  function openModal(id) {
    var m = document.getElementById(id);
    if (!m) return;
    m.classList.add('open');
    m.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id) {
    var m = document.getElementById(id);
    if (!m) return;
    m.classList.remove('open');
    m.setAttribute('aria-hidden', 'true');
    if (!document.querySelector('.modal.open, .meet-modal.open')) {
      document.body.style.overflow = '';
    }
  }

  document.querySelectorAll('[data-close]').forEach(function (b) {
    b.addEventListener('click', function () { closeModal(b.getAttribute('data-close')); });
  });
  document.querySelectorAll('.modal').forEach(function (m) {
    m.addEventListener('click', function (e) { if (e.target === m) closeModal(m.id); });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var meet = document.getElementById('meetModal');
    if (meet.classList.contains('open')) { closeMeet(); return; }
    var open = document.querySelector('.modal.open');
    if (open) closeModal(open.id);
  });

  /* =========================================================
     Populate category selects
     ========================================================= */
  var pinCategory = document.getElementById('pinCategory');
  var createCategory = document.getElementById('cCategory');

  (function () {
    var inst = document.createElement('option');
    inst.value = 'Instant interview';
    inst.textContent = 'Instant interview (room PIN)';
    pinCategory.appendChild(inst);

    CATS.forEach(function (c) {
      var o1 = document.createElement('option');
      o1.value = c; o1.textContent = c;
      pinCategory.appendChild(o1);

      var o2 = document.createElement('option');
      o2.value = c; o2.textContent = c;
      createCategory.appendChild(o2);
    });
  })();

  /* =========================================================
     PIN gate
     ========================================================= */
  var pinForm = document.getElementById('pinForm');
  var pinCode = document.getElementById('pinCode');
  var pinName = document.getElementById('pinName');
  var pinEmail = document.getElementById('pinEmail');
  var pinNote = document.getElementById('pinNote');
  var pinTitle = document.getElementById('pinTitle');
  var pinSubtitle = document.getElementById('pinSubtitle');

  var pendingSessionId = null;

  function openPinModal(sessionId) {
    pendingSessionId = sessionId || null;
    pinNote.textContent = '';
    pinNote.classList.remove('error', 'ok');
    pinCode.value = '';

    var session = null;
    if (pendingSessionId) {
      session = SESSIONS.filter(function (x) { return x.id === pendingSessionId; })[0] || null;
    }

    if (session) {
      pinCategory.value = session.instant ? 'Instant interview' : session.category;
      pinTitle.textContent = session.title;
      pinSubtitle.textContent = session.instant
        ? 'Instant interview · Host: ' + session.host
        : session.category + ' · ' + fmtDateTime(session.start) + ' · Host: ' + session.host;
    } else {
      pinTitle.textContent = 'Join a webinar or interview';
      pinSubtitle.textContent = 'Enter your category PIN, or the one-time room PIN for an instant interview.';
      pinCategory.value = 'Instant interview';
    }

    openModal('pinModal');
    setTimeout(function () { pinCode.focus(); }, 60);
  }

  document.querySelectorAll('[data-join-open]').forEach(function (b) {
    b.addEventListener('click', function () { openPinModal(null); });
  });

  sessionListEl.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-join]');
    if (!btn) return;
    openPinModal(btn.getAttribute('data-join'));
  });

  pinCode.addEventListener('input', function () {
    pinCode.value = pinCode.value.replace(/\D/g, '').slice(0, 6);
  });

  /* verification */
  function attemptJoin(category, pin) {
    var pins = readCategoryPins();

    if (pendingSessionId) {
      var s = SESSIONS.filter(function (x) { return x.id === pendingSessionId; })[0];
      if (!s) return { ok: false, msg: 'That session is no longer available.' };

      if (s.instant) {
        if (s.pin !== pin) return { ok: false, msg: 'That PIN does not match this interview room.' };
        if (sessionState(s).key === 'ended') {
          return { ok: false, msg: 'This interview room has already ended.' };
        }
        return { ok: true, session: s };
      }

      if (pins[s.category] !== pin) {
        var ownerS = CATS.filter(function (c) { return pins[c] === pin; })[0];
        if (ownerS) {
          return { ok: false, msg: 'That is the ' + ownerS + ' PIN. This session is for ' + s.category + ' only.' };
        }
        return { ok: false, msg: 'That PIN does not unlock this session.' };
      }

      var st = sessionState(s);
      if (st.key === 'upcoming') {
        return {
          ok: false,
          msg: 'This session opens at ' + fmtTime(st.opens) + ' (' + fmtDateTime(s.start) + ').'
        };
      }
      if (st.key === 'ended') {
        return { ok: false, msg: 'This session has already ended. Ask your account manager for the replay.' };
      }
      return { ok: true, session: s };
    }

    var instantRoom = SESSIONS.filter(function (s) {
      return s.type === 'interview' && s.instant && s.pin === pin;
    })[0];

    if (instantRoom) {
      if (sessionState(instantRoom).key === 'ended') {
        return { ok: false, msg: 'That instant room has ended. Ask the interviewer to open a new one.' };
      }
      return { ok: true, session: instantRoom };
    }

    if (category === 'Instant interview') {
      return { ok: false, msg: 'No live instant interview room uses that PIN. Ask the interviewer to share it again.' };
    }

    if (pins[category] !== pin) {
      var owner = CATS.filter(function (c) { return pins[c] === pin; })[0];
      if (owner) {
        return {
          ok: false,
          msg: 'That is the ' + owner + ' PIN. Switch your category to ' + owner + ' and try again.'
        };
      }
      return { ok: false, msg: 'That PIN is not recognised. Check with your account manager.' };
    }

    var pool = SESSIONS.filter(function (s) {
      return !s.instant && (s.category === category || s.category === 'All partners');
    }).sort(function (a, b) { return a.start - b.start; });

    var live = pool.filter(function (s) { return sessionState(s).key === 'live'; })[0];
    if (live) return { ok: true, session: live };

    var next = pool.filter(function (s) { return s.start > Date.now(); })[0];
    if (next) {
      return {
        ok: false,
        msg: 'PIN verified, but no ' + category + ' session is live right now. Next one opens at ' +
             fmtTime(next.start - JOIN_WINDOW_MS) + ' on ' + fmtDateTime(next.start) + '.'
      };
    }

    return { ok: false, msg: 'PIN verified, but there are no ' + category + ' sessions scheduled yet.' };
  }

  pinForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var category = pinCategory.value;
    var pin = pinCode.value.trim();
    var name = pinName.value.trim();
    var email = pinEmail.value.trim();

    pinNote.classList.remove('error', 'ok');

    if (pin.length !== 6) {
      pinNote.textContent = 'Enter the 6-digit PIN.';
      pinNote.classList.add('error');
      pinCode.focus();
      return;
    }
    if (name.length < 2) {
      pinNote.textContent = 'Please enter your full name.';
      pinNote.classList.add('error');
      pinName.focus();
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      pinNote.textContent = 'Please enter a valid email address.';
      pinNote.classList.add('error');
      pinEmail.focus();
      return;
    }

    var result = attemptJoin(category, pin);
    if (!result.ok) {
      pinNote.textContent = result.msg;
      pinNote.classList.add('error');
      return;
    }

    pinNote.textContent = 'Verified — opening the room…';
    pinNote.classList.add('ok');

    var session = result.session;
    var viewerCategory = session.instant ? 'Interviews' : category;
    setTimeout(function () {
      closeModal('pinModal');
      openMeet(session, name, viewerCategory, false);
    }, 450);
  });

  /* Prefill from ?pin= */
  try {
    var params = new URLSearchParams(window.location.search);
    var urlPin = params.get('pin');
    if (urlPin && /^\d{6}$/.test(urlPin)) {
      openPinModal(null);
      pinCode.value = urlPin;

      var pins0 = readCategoryPins();
      var owner0 = CATS.filter(function (c) { return pins0[c] === urlPin; })[0];
      if (owner0) {
        pinCategory.value = owner0;
      } else {
        pinCategory.value = 'Instant interview';
      }
    }
  } catch (e) {}

  /* =========================================================
     Admin panel
     ========================================================= */
  var adminGate = document.getElementById('adminGate');
  var adminPanel = document.getElementById('adminPanel');
  var adminGateForm = document.getElementById('adminGateForm');
  var adminPass = document.getElementById('adminPass');
  var adminGateNote = document.getElementById('adminGateNote');
  var adminList = document.getElementById('adminList');
  var catPinList = document.getElementById('catPinList');
  var createForm = document.getElementById('createForm');
  var createNote = document.getElementById('createNote');
  var instantForm = document.getElementById('instantForm');
  var instantNote = document.getElementById('instantNote');

  var adminUnlocked = false; /* in-memory only for this page view */

  function openAdmin() {
    openModal('adminModal');

    if (adminUnlocked) {
      adminGate.hidden = true;
      adminPanel.hidden = false;
      renderCatPins();
      renderAdminList();
      return;
    }

    adminGate.hidden = false;
    adminPanel.hidden = true;
    adminGateNote.textContent = '';
    adminGateNote.classList.remove('error');
    adminPass.value = '';
    setTimeout(function () { adminPass.focus(); }, 60);
  }
  document.getElementById('adminOpenBtn').addEventListener('click', openAdmin);
  document.getElementById('adminOpenBtn2').addEventListener('click', openAdmin);

  adminGateForm.addEventListener('submit', function (e) {
    e.preventDefault();
    if (adminPass.value !== ADMIN_PASS) {
      adminGateNote.textContent = 'Incorrect passcode. Try admin1234 for the demo.';
      adminGateNote.classList.add('error');
      adminPass.focus();
      return;
    }
    adminGateNote.textContent = '';
    adminGateNote.classList.remove('error');
    adminUnlocked = true;
    adminGate.hidden = true;
    adminPanel.hidden = false;
    renderCatPins();
    renderAdminList();
  });

  /* ----- category PIN list ----- */
  function renderCatPins() {
    if (!catPinList) return;
    var pins = readCategoryPins();

    catPinList.innerHTML = CATS.map(function (c) {
      return '' +
        '<div class="admin-row">' +
          '<div class="admin-row-info">' +
            '<strong>' + esc(c) + '</strong>' +
            '<small>Access PIN for all ' + esc(c.toLowerCase()) + ' sessions</small>' +
          '</div>' +
          '<span class="admin-pin">' + esc(pins[c]) + '</span>' +
          '<div class="admin-actions">' +
            '<button class="icon-btn" data-copy-catpin="' + esc(c) + '" title="Copy PIN" aria-label="Copy ' + esc(c) + ' PIN">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>' +
            '</button>' +
            '<button class="icon-btn danger" data-regen-catpin="' + esc(c) + '" title="Regenerate PIN" aria-label="Regenerate ' + esc(c) + ' PIN">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>' +
            '</button>' +
          '</div>' +
        '</div>';
    }).join('');
  }

  catPinList.addEventListener('click', function (e) {
    var copyBtn = e.target.closest('[data-copy-catpin]');
    var regenBtn = e.target.closest('[data-regen-catpin]');

    if (copyBtn) {
      var c1 = copyBtn.getAttribute('data-copy-catpin');
      var pins = readCategoryPins();
      copyText(pins[c1], c1 + ' PIN copied — share it privately with that group.');
    }

    if (regenBtn) {
      var c2 = regenBtn.getAttribute('data-regen-catpin');
      var current = readCategoryPins();
      var taken = Object.keys(current).map(function (k) { return current[k]; })
        .concat(SESSIONS.map(function (s) { return s.pin; }));
      var fresh;
      var guard = 0;
      do { fresh = genPin(); guard++; }
      while (taken.indexOf(fresh) !== -1 && guard < 60);

      current[c2] = fresh;
      saveCategoryPins(current);
      renderCatPins();
      renderAdminList();
      paintCategoryPins();
      toast(c2 + ' PIN regenerated · ' + fresh);
    }
  });

  function paintCategoryPins() {
    var pins = readCategoryPins();
    document.querySelectorAll('[data-catpin]').forEach(function (el) {
      el.textContent = pins[el.getAttribute('data-catpin')] || '••••••';
    });
  }
