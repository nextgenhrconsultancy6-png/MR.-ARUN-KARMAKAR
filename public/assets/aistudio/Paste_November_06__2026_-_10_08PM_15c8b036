    stage.classList.remove('sharing');
    shareBtn.classList.remove('off');
  }

  function toggleShare() {
    if (screenStream) { stopShare(); return; }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
      toast('Screen sharing is not supported in this browser.');
      return;
    }
    navigator.mediaDevices.getDisplayMedia({ video: true })
      .then(function (stream) {
        screenStream = stream;
        screenVideo.srcObject = stream;
        screenShareEl.classList.add('show');
        stage.classList.add('sharing');
        shareBtn.classList.add('off');
        stream.getVideoTracks()[0].addEventListener('ended', stopShare);
